# The service is bound to 127.0.0.1 and used only by the local kiosk.
# Set this to true and configure API_TOKEN before exposing the API on a network.
API_AUTH_ENABLED=false
API_TOKEN=

# A DEMANDER A LA RESPONSABLE FOUAILLE:
# - dedicated MySQL user and password
# - private host, port and exact database name
# - Orange Pi network access (VLAN/VPN/IP allow-list) and optional TLS CA
# URL-encode special characters contained in the username or password.
DATABASE_URL=mysql://FOUAILLE_SQL_USER:FOUAILLE_SQL_PASSWORD@FOUAILLE_SQL_HOST:3306/FOUAILLE_SQL_DATABASE

# When DATABASE_URL points directly to Fouaille's database, the catalogue is
# already current: keep synchronization disabled to avoid redundant writes.
# Enable it only when using a separate Marco cache database; it then runs every
# five minutes and keeps the last imported catalogue after a network failure.
FOUAILLE_API_URL=https://fouaille.bde-tps.fr/api/product
FOUAILLE_SYNC_ENABLED=false
FOUAILLE_SYNC_INTERVAL_MS=300000

# Stored in the marco_prime_data Docker volume
MARCO_DATA_DIR=/app/data

API_PORT=3000
MARCO_HOST_PORT=3001
# Agrandissement de l'interface sur le petit écran tactile (1.0 = taille normale).
MARCO_KIOSK_SCALE=1.75
NODE_ENV=production
TZ=Europe/Paris
FRONTEND_URL=http://127.0.0.1:3001
