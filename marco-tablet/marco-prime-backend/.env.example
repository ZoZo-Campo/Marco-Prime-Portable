API_PORT=3000

# Token interne Marco. Generer avec: openssl rand -hex 16
# Le frontend doit utiliser exactement la meme valeur dans VITE_API_TOKEN.
API_AUTH_ENABLED=true
API_TOKEN="REPLACE_HERE_MARCO_API_TOKEN"

# REMPLACER ICI les 5 valeurs fournies par l'administratrice Fouaille Manager.
# Encoder les caracteres speciaux presents dans l'utilisateur ou le mot de passe.
DATABASE_URL="mysql://REPLACE_HERE_FOUAILLE_DB_USERNAME:REPLACE_HERE_FOUAILLE_DB_PASSWORD@REPLACE_HERE_FOUAILLE_DB_HOST:REPLACE_HERE_FOUAILLE_DB_PORT/REPLACE_HERE_FOUAILLE_DB_NAME"

NODE_ENV="development"
FRONTEND_URL="http://localhost:5173,http://127.0.0.1:5173"

# Connexion directe a la base Fouaille : pas de copie dans une base locale.
FOUAILLE_API_URL="https://fouaille.bde-tps.fr/api/product"
FOUAILLE_SYNC_ENABLED="false"
FOUAILLE_SYNC_INTERVAL_MS="300000"

# Seule la selection des produits vendus ce soir reste locale a la Marco.
MARCO_DATA_DIR="./data"
