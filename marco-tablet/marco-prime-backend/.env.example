# ============================================================
# Marco Prime - configuration du serveur (tablette)
# ------------------------------------------------------------
# 1. Copier ce fichier en `.env` :
#      cp .env.example .env
# 2. Remplacer les valeurs en MAJUSCULES (UTILISATEUR, MOT_DE_PASSE, ...).
# 3. Ne jamais committer le fichier `.env` : il contient des secrets.
#
# Le fichier `.env` peut aussi etre importe depuis l'interface :
#   Configuration > Installation > Importer un fichier .env
# L'import remplace l'ancien fichier et cree une sauvegarde `.env.bak-...`.
# ============================================================

# Port du serveur Marco sur la tablette. Garder 3001.
API_PORT=3001

# Laisser false sur la tablette : le serveur n'ecoute que sur 127.0.0.1.
# Passer a true pour exiger un token interne, meme en local.
API_AUTH_ENABLED=false

# Token interne, obligatoire uniquement si API_AUTH_ENABLED=true.
# Generer avec : openssl rand -hex 16
# Le frontend doit utiliser exactement la meme valeur dans VITE_API_TOKEN.
API_TOKEN=

# Base MySQL Fouaille, fournie par l'administratrice.
# Format : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_DE_LA_BASE
# Encoder les caracteres speciaux du mot de passe (ex: @ -> %40).
DATABASE_URL="mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3307/NOM_DE_LA_BASE"

# production sur la tablette, development sur un ordinateur de dev.
NODE_ENV=production

# Origine autorisee pour le navigateur de la tablette.
FRONTEND_URL=http://127.0.0.1:3001

# Synchronisation Fouaille : laisser false sauf besoin explicite.
FOUAILLE_API_URL="https://fouaille.bde-tps.fr/api/product"
FOUAILLE_SYNC_ENABLED=false
FOUAILLE_SYNC_INTERVAL_MS=300000

# Dossier des donnees locales de la tablette (catalogue, compta, etc.).
# Il est cree automatiquement a l'import si besoin.
MARCO_DATA_DIR=/data/data/com.termux/files/home/marco-tablet/data

# Ancien nom du port hote, conserve pour compatibilite. Optionnel.
MARCO_HOST_PORT=3001
